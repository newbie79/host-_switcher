{
  "manifest_version": 3,
  "name": "Host Switcher",
  "version": "1.0.0",
  "description": "hosts 파일 수정 없이 팝업 클릭만으로 도메인을 여러 서버 IP 중 하나로 라우팅합니다.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Host Switcher"
  },
  "options_page": "options.html"
}
